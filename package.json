{
  "name": "agent-memory-monorepo",
  "version": "0.5.0",
  "description": "Persistent long-term memory for LLM agents \u2014 multi-tier (user/agent/session), hybrid vector + BM25 search, encryption, PII redaction, SQLite + Postgres + React + Vercel AI SDK + CLI.",
  "private": true,
  "keywords": [
    "ai",
    "ai-agent",
    "ai-memory",
    "agent",
    "agent-memory",
    "anthropic",
    "chatbot",
    "claude",
    "cli",
    "embeddings",
    "llm",
    "llm-agent",
    "llm-memory",
    "memory",
    "memory-engine",
    "monorepo",
    "ollama",
    "openai",
    "pgvector",
    "postgres",
    "rag",
    "react",
    "semantic-search",
    "sqlite",
    "typescript",
    "vector-search",
    "vercel-ai-sdk"
  ],
  "homepage": "https://github.com/Namitjain07/agent-memory#readme",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "cd packages/agent-memory && npx vitest bench --run",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/mocker": "^5.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "nanoid": "^5.1.5",
    "esbuild": "^0.28.0"
  },
  "resolutions": {
    "postcss": "^8.5.28",
    "nanoid": "^5.1.5",
    "esbuild": "^0.28.0"
  }
}
