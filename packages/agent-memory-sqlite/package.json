{
  "name": "@namitjain.india/agent-memory-sqlite",
  "version": "0.1.1",
  "description": "SQLite adapter for agent-memory",
  "repository": {
    "type": "git",
    "url": "https://github.com/Namitjain07/agent-memory.git"
  },
  "homepage": "https://github.com/Namitjain07/agent-memory#readme",
  "bugs": {
    "url": "https://github.com/Namitjain07/agent-memory/issues"
  },
  "keywords": [
    "ai",
    "memory",
    "agent",
    "sqlite",
    "persistence",
    "local-storage",
    "vector-search"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "peerDependencies": {
    "@namitjain.india/agent-memory": "^0.1.0",
    "better-sqlite3": "^11.0.0",
    "sqlite-vss": "^0.1.2"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "sqlite-vss": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
