{
  "name": "@namitjain.india/agent-memory-sqlite",
  "version": "0.5.0",
  "description": "SQLite adapter for agent-memory. Persistent long-term LLM agent memory for edge runtimes, local apps, and single-server deployments. Pure-JS cosine similarity search, optional sqlite-vss extension.",
  "keywords": [
    "agent-memory",
    "ai",
    "ai-memory",
    "agent",
    "better-sqlite3",
    "chatbot",
    "edge-runtime",
    "embeddings",
    "llm",
    "llm-agent",
    "local-storage",
    "memory",
    "memory-engine",
    "persistence",
    "persistent-memory",
    "rag",
    "serverless",
    "semantic-search",
    "sqlite",
    "sqlite-vss",
    "typescript",
    "vector-search",
    "vercel-edge"
  ],
  "license": "MIT",
  "author": {
    "name": "Namit Jain",
    "url": "https://github.com/Namitjain07"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Namitjain07/agent-memory.git",
    "directory": "packages/agent-memory-sqlite"
  },
  "homepage": "https://github.com/Namitjain07/agent-memory#readme",
  "bugs": {
    "url": "https://github.com/Namitjain07/agent-memory/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Namitjain07"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@namitjain.india/agent-memory": ">=0.5.0",
    "better-sqlite3": "^11.0.0",
    "sqlite-vss": "^0.1.2"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "sqlite-vss": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.4.1"
  }
}
