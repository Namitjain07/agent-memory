{
  "name": "@namitjain.india/agent-memory-react",
  "version": "0.3.0",
  "description": "React hook utilities for agent-memory",
  "repository": {
    "type": "git",
    "url": "https://github.com/Namitjain07/agent-memory.git"
  },
  "homepage": "https://github.com/Namitjain07/agent-memory#readme",
  "bugs": {
    "url": "https://github.com/Namitjain07/agent-memory/issues"
  },
  "keywords": [
    "ai",
    "memory",
    "agent",
    "react",
    "hook",
    "llm",
    "context"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external react"
  },
  "peerDependencies": {
    "@namitjain.india/agent-memory": ">=0.3.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
