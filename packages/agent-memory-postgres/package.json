{
  "name": "@namitjain.india/agent-memory-postgres",
  "version": "0.5.0",
  "description": "PostgreSQL + pgvector adapter for agent-memory. Production-grade long-term memory for LLM agents at scale with native HNSW vector indexes, multi-tenant isolation, and connection pooling.",
  "keywords": [
    "agent-memory",
    "ai",
    "ai-memory",
    "agent",
    "ann",
    "chatbot",
    "embeddings",
    "hnsw",
    "ivfflat",
    "llm",
    "llm-agent",
    "memory",
    "memory-engine",
    "multi-tenant",
    "persistence",
    "persistent-memory",
    "pgvector",
    "postgres",
    "postgresql",
    "production",
    "rag",
    "semantic-search",
    "sql",
    "typescript",
    "vector-database",
    "vector-search"
  ],
  "license": "MIT",
  "author": {
    "name": "Namit Jain",
    "url": "https://github.com/Namitjain07"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Namitjain07/agent-memory.git",
    "directory": "packages/agent-memory-postgres"
  },
  "homepage": "https://github.com/Namitjain07/agent-memory#readme",
  "bugs": {
    "url": "https://github.com/Namitjain07/agent-memory/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Namitjain07"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "peerDependencies": {
    "@namitjain.india/agent-memory": ">=0.5.0",
    "pg": "^8.0.0",
    "pgvector": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "pgvector": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
