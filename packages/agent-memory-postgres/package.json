{
  "name": "@namitjain.india/agent-memory-postgres",
  "version": "0.1.0",
  "description": "Postgres adapter for agent-memory using pgvector",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "peerDependencies": {
    "@namitjain.india/agent-memory": "^0.1.0",
    "pg": "^8.0.0",
    "pgvector": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "pgvector": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
