{
  "name": "@namitjain.india/agent-memory-postgres",
  "version": "0.1.1",
  "description": "Postgres adapter for agent-memory using pgvector",
  "repository": {
    "type": "git",
    "url": "https://github.com/Namitjain07/agent-memory.git"
  },
  "homepage": "https://github.com/Namitjain07/agent-memory#readme",
  "bugs": {
    "url": "https://github.com/Namitjain07/agent-memory/issues"
  },
  "keywords": [
    "ai",
    "memory",
    "agent",
    "postgres",
    "postgresql",
    "pgvector",
    "vector-search",
    "production",
    "persistence"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "peerDependencies": {
    "@namitjain.india/agent-memory": "^0.1.0",
    "pg": "^8.0.0",
    "pgvector": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "pgvector": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
