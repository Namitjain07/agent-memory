{
  "name": "@namitjain.india/agent-memory-vercel",
  "version": "0.1.0",
  "description": "Drop-in Vercel AI SDK memory middleware for agent-memory",
  "repository": {
    "type": "git",
    "url": "https://github.com/Namitjain07/agent-memory.git"
  },
  "homepage": "https://github.com/Namitjain07/agent-memory#readme",
  "bugs": {
    "url": "https://github.com/Namitjain07/agent-memory/issues"
  },
  "keywords": [
    "ai",
    "memory",
    "agent",
    "vercel",
    "vercel-ai-sdk",
    "ai-sdk",
    "stream",
    "chat"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@namitjain.india/agent-memory": ">=0.4.0",
    "ai": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@namitjain.india/agent-memory": "*"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
